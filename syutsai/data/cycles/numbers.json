{
  "version": "syutsai-date-core-v2+weekly-adapter-v1",
  "status": "interpretation",
  "coreFormula": {
    "consciousness": "digitalRoot(dayOfBirth)",
    "mission": "digitalRoot(allBirthDateDigits)"
  },
  "weeklyAdapter": "year=digitalRoot(mission+yearDigits); month=digitalRoot(year+month); week=digitalRoot(month+ISOWeek)",
  "birthTimeAffectsCore": false,
  "nameAffectsCore": false,
  "numbers": {
    "1": ["initiative", "speed"],
    "2": ["cooperation", "patience"],
    "3": ["communication", "creative"],
    "4": ["structure", "focus"],
    "5": ["change", "experiment"],
    "6": ["care", "responsibility"],
    "7": ["depth", "analysis"],
    "8": ["ambition", "money"],
    "9": ["completion", "meaning"]
  }
}

